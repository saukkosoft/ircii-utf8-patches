+/* Convert Latin-1 (ISO-8859-1) characters to UTF-8 for display */
+static void fix_latin1_to_utf8(const u_char *input, u_char *output)
+{
+	while (*input)
+	{
+		unsigned char b = (unsigned char)*input;
+		unsigned char next = (unsigned char)*(input + 1);
+		
+		/* If this looks like UTF-8 start AND has proper continuation, copy as-is */
+		if (b >= 0xC2 && b <= 0xF4 && next >= 0x80 && next < 0xC0)
+		{
+			*output++ = *input++;
+			while ((unsigned char)*input >= 0x80 && (unsigned char)*input < 0xC0)
+				*output++ = *input++;
+		}
+		/* Latin-1 character 0xA0-0xFF -> convert to UTF-8 */
+		else if (b >= 0xA0)
+		{
+			*output++ = 0xC3;
+			*output++ = b - 0x40;
+			input++;
+		}
+		else
+		{
+			*output++ = *input++;
+		}
+	}
+	*output = '\0';
+}
